# ytdl-hoarder Environment Variables
#
# This file is Docker Compose's variable file, not application config. Compose
# reads it to resolve the ${...} placeholders inside docker-compose.*.yml; the
# backend never sees it, because neither compose file declares `env_file:`.
#
# Application settings live in config.yml (see config.sample.yml). Everything
# below is here because it is consumed *outside* the backend process — by
# Compose itself, by the Next.js build, or by uvicorn — and so has nowhere else
# to go.

# Media storage paths on the host (mounted into the container). Must be
# absolute paths or start with ./ — a bare relative path like "media/audio" is
# read by Compose as a *named volume*, so downloads land in Docker's volume
# store instead of on your disk.
AUDIO_ONLY_PATH=./data/media/audio
VIDEO_PATH=./data/media/video

# The prebuilt release image, read only by docker-compose.published.yml.
# `latest` follows the newest release; pin a version (e.g. v0.1.0) to hold one.
# Updates are opt-in either way — a running container is never replaced until
# you pull. YTDL_HOARDER_IMAGE only changes for a fork or a registry mirror.
# docker-compose.prod.yml and .dev.yml build locally and ignore both.
YTDL_HOARDER_IMAGE=ghcr.io/kkuhlmann/ytdl-hoarder
YTDL_HOARDER_TAG=latest

# ── Dev mode only ───────────────────────────────────────────────────────────
# Both variables below are read exclusively by docker-compose.dev.yml. Ignore
# them if you run the published image or build with docker-compose.prod.yml.

# Frontend API endpoint, baked into the JS bundle at *build time* (editing this
# alone won't take effect without a rebuild:
# docker compose -f docker-compose.dev.yml up -d --build frontend).
# Only needs to change if you'll open the UI from a different device than
# the one running Docker (LAN IP, domain, etc.) - see README Configuration.
# Prod and published modes ignore it; they use a same-origin /api path.
NEXT_PUBLIC_BACKEND_API=http://localhost:8000

# Extra hostnames allowed to load Next.js dev resources (hot reload). Next 16
# blocks cross-origin dev requests, so opening the dev UI as anything other
# than localhost needs its host allowed or hot reload stops working.
# The host in NEXT_PUBLIC_BACKEND_API above is allowed automatically, so most
# setups can leave this empty. Comma-separated, hostnames only (no scheme/port).
ALLOWED_DEV_ORIGINS=

# ── All modes ───────────────────────────────────────────────────────────────

# Upstream addresses permitted to set X-Forwarded-For, read by uvicorn (not a
# config.yml key). Sign-in rate limits are per client address, so if you run behind
# a reverse proxy, set this to the proxy's address — otherwise every visitor looks
# like the proxy and shares a single budget. Leave alone if nothing fronts the app.
# FORWARDED_ALLOW_IPS=127.0.0.1
